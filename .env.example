# ================================================================
# FaceTrace Ledger - Environment Configuration
# ================================================================

# Face Recognition Settings
FACE_MATCH_THRESHOLD=0.65

# Reverse Image Search Configuration
# Options: 'serpapi_lens', 'bing_visual', 'searchapi_lens'
REVERSE_SEARCH_PROVIDER=serpapi_lens

# API Key for the selected provider (e.g. SerpApi private key)
# Get your free key at: https://serpapi.com
SEARCH_API_KEY=

# Blockchain Configuration (Ethereum Compatible: Ganache / Hardhat / Anvil / PyEVM)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d

# Deployed Smart Contract Address (set after running scripts/deploy_contract.py)
CONTRACT_ADDRESS=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
